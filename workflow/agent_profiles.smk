"""Agent-input profiles only. Existing assemblies and QC outputs untouched.

Do not pass sample IDs, input paths, benchmark metadata or reference-based QUAST
reports to the model. Only load the JSON CONTENT generated by these rules.
"""

# This is a known-organism size PRIOR, not the 4,641,652 bp reference genome.
# You may override it under 'agent_qc' in config.yaml if appropriate.
AGENT_SIZE_PRIOR = int(config.get("agent_qc", {}).get("expected_genome_size_bp", 4600000))

rule agent_profile_lowcov:
    input:
        r1="data/failures/lowcov/{coverage}x/R1.fastq.gz",
        r2="data/failures/lowcov/{coverage}x/R2.fastq.gz",
        quast="results/lowcov/{coverage}x/quast/report.tsv"
    output:
        "results/agent_profiles/{coverage}x/profile.json"
    params:
        prior=AGENT_SIZE_PRIOR
    log:
        "logs/agent_profile_{coverage}x.log"
    wildcard_constraints:
        coverage="8|15|30"
    shell:
        """
        mkdir -p logs
        python scripts/build_agent_profile.py \
            --r1 {input.r1:q} --r2 {input.r2:q} --quast {input.quast:q} \
            --expected-genome-size-bp {params.prior} --output {output:q} > {log:q} 2>&1
        """

rule agent_profile_full:
    input:
        r1="results/trimmed/reads/R1.fastq.gz",
        r2="results/trimmed/reads/R2.fastq.gz",
        quast="results/trimmed/quast/report.tsv"
    output:
        "results/agent_profiles/full/profile.json"
    params:
        prior=AGENT_SIZE_PRIOR
    log:
        "logs/agent_profile_full.log"
    shell:
        """
        mkdir -p logs
        python scripts/build_agent_profile.py \
            --r1 {input.r1:q} --r2 {input.r2:q} --quast {input.quast:q} \
            --expected-genome-size-bp {params.prior} --output {output:q} > {log:q} 2>&1
        """
